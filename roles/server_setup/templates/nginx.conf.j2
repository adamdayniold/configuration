events { worker_connections 1024; }

http {
    # 🕵️ Hide Nginx version tokens for security
    server_tokens off;

    server {
        listen 80;
        server_name _; # Your VM URL

        # 🚀 Forward all public web traffic to the internal Next.js container
        location / {
            proxy_pass http://crud-mongodb:3000; # Points directly to your app service name
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
